{
  "manifest_version": 3,
  "name": "Wordbook",
  "version": "1.0.0",
  "description": "Save unfamiliar words from any page via the context menu; meaning, part of speech, and example sentence are auto-filled.",
  "permissions": ["alarms", "contextMenus", "storage", "tabs"],
  "host_permissions": ["https://translate.googleapis.com/*", "https://text.pollinations.ai/*", "https://dict.youdao.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Wordbook",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}