{
  "manifest_version": 3,
  "name": "Wordbook",
  "version": "1.0.0",
  "description": "Save unfamiliar words from any page via the context menu; meaning, part of speech, and example sentence are auto-filled.",
  "permissions": ["contextMenus", "storage", "tabs"],
  "host_permissions": ["https://translate.googleapis.com/*", "https://text.pollinations.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Wordbook",
    "default_popup": "popup.html"
  }
}